# ========================================================
# CloudVault Backend Environment Configuration
# ========================================================

# Active Spring Profile (dev = H2 database, postgres = PostgreSQL/Supabase)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (for postgres profile)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-supabase-id.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password

# JWT Token Security (256-bit hexadecimal key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Storage Engine (filesystem = local disk, database = PostgreSQL BYTEA)
APP_STORAGE_TYPE=filesystem
APP_STORAGE_UPLOAD_DIR=./storage_uploads

# Frontend URL (Used for generating one-click email verification links)
APP_FRONTEND_URL=https://cloud-based-file-storage-system-delta.vercel.app

# ========================================================
# SMTP Email Service Configuration (for Email Verification)
# ========================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

APP_MAIL_FROM=your-email@gmail.com
APP_MAIL_SENDER_NAME=CloudVault Security
